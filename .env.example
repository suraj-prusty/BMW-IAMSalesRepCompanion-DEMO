# NEVER commit this file to git. It contains secrets.
# This file is a template — copy to .env and fill in real values.
# In production, use Azure Key Vault or AWS Secrets Manager.

# ── Server ───────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Azure OpenAI ─────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Demo Auth (POC only — replace with Azure AD/Entra ID in production) ──
DEMO_EMAIL=demo.agenticai@corporate.com
DEMO_PASSWORD=change-me-in-production
