# NEVER commit this file to git. It contains secrets.
# This file is a template — copy to .env and fill in real values.
# In production, use Azure Key Vault or AWS Secrets Manager.

PORT=8080
NODE_ENV=production

# FastAPI backend hosted on AWS (no trailing slash)
VITE_API_URL=https://your-aws-fastapi-url.com

# Local Express server for AI endpoints
VITE_AI_URL=http://localhost:8080

# Storage backend for recommendations + visit capture.
# true (default) = local JSON files in table_structures/ via `npm run dev:server`.
# false = the AWS APIs below (shared DynamoDB tables, unauthenticated POC).
# Restart `npm run dev` after changing any VITE_ value.
VITE_DEBUG_MODE=true
VITE_VISIT_CAPTURE_API_URL=https://your-visit-capture-api-id.execute-api.eu-central-1.amazonaws.com
VITE_RECOMMENDATION_API_URL=https://your-recommendation-api-id.execute-api.eu-central-1.amazonaws.com

AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# AWS Bedrock
BEDROCK_MODEL_ID=your-bedrock-model-or-inference-profile-id

# AWS account resources
AWS_PROFILE=your-aws-profile
AWS_REGION=eu-central-1
S3_BUCKET=your-s3-bucket-name

DEMO_EMAIL=demo.agenticai@corporate.com
DEMO_PASSWORD=change-me-in-production
MANAGER_EMAIL=manager.demo@corporate.com
MANAGER_PASSWORD=change-me-in-production
MARCUS_EMAIL=marcus@example.com
MARCUS_PASSWORD=change-me-in-production
SOFIA_EMAIL=sofia@example.com
SOFIA_PASSWORD=change-me-in-production
